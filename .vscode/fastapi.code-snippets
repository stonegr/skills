{
    "定义 GET 路由": {
        "prefix": "fa_route_get",
        "body": [
            "from fastapi import FastAPI",
            "app = FastAPI()",
            "",
            "@app.get(${1:'/items'})",
            "async def ${2:read_items}():",
            "    return ${3:{'message': 'Hello'}}"
        ],
        "description": "定义 GET 路由"
    },
    "定义 POST 路由": {
        "prefix": "fa_route_post",
        "body": [
            "from fastapi import FastAPI",
            "app = FastAPI()",
            "",
            "@app.post(${1:'/items'})",
            "async def ${2:create_item}(${3:item}: dict):",
            "    return ${3:item}"
        ],
        "description": "定义 POST 路由"
    },
    "定义 PUT 路由": {
        "prefix": "fa_route_put",
        "body": [
            "from fastapi import FastAPI",
            "app = FastAPI()",
            "",
            "@app.put(${1:'/items/{id}'})",
            "async def ${2:update_item}(${3:id: int}, ${4:item: dict}):",
            "    return ${5:{'id': id, **item}}"
        ],
        "description": "定义 PUT 路由"
    },
    "定义 DELETE 路由": {
        "prefix": "fa_route_delete",
        "body": [
            "from fastapi import FastAPI",
            "app = FastAPI()",
            "",
            "@app.delete(${1:'/items/{id}'})",
            "async def ${2:delete_item}(${3:id: int}):",
            "    return ${4:{'deleted': id}}"
        ],
        "description": "定义 DELETE 路由"
    },
    "模块化路由": {
        "prefix": "fa_router",
        "body": [
            "from fastapi import APIRouter, FastAPI",
            "router = APIRouter(prefix=${1:'/items'}, tags=[${2:'items'}])",
            "",
            "@router.get(${3:'/'})",
            "async def ${4:list_items}():",
            "    return ${5:[]}",
            "",
            "app = FastAPI()",
            "app.include_router(router)"
        ],
        "description": "模块化路由"
    },
    "包含路由到应用": {
        "prefix": "fa_include_router",
        "body": [
            "from fastapi import FastAPI",
            "app = FastAPI()",
            "",
            "app.include_router(${1:router}, prefix=${2:'/api'}, tags=${3:None})"
        ],
        "description": "包含路由到应用"
    },
    "路径参数 id": {
        "prefix": "fa_path_param",
