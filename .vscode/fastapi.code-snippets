    "TestClient 测试 GET 接口": {
        "prefix": "fa_test_get",
        "body": [
            "from fastapi import FastAPI",
            "from fastapi.testclient import TestClient",
            "",
            "app = FastAPI()",
            "",
            "@app.get(${1:'/'})",
            "async def ${2:read_root}():",
            "    return ${3:{'hello': 'world'}}",
            "",
            "client = TestClient(app)",
            "response = client.get(${1:'/'})",
            "assert response.status_code == ${4:200}",
            "assert response.json() == ${3:{'hello': 'world'}}"
        ],
        "description": "TestClient 测试 GET 接口"
    },
    "TestClient 测试 POST 接口": {
        "prefix": "fa_test_post",
        "body": [
            "from fastapi import FastAPI",
            "from fastapi.testclient import TestClient",
            "",
            "app = FastAPI()",
            "",
            "@app.post(${1:'/items'})",
            "async def ${2:create_item}(${3:item}: dict):",
            "    return ${3:item}",
            "",
            "client = TestClient(app)",
            "response = client.post(${1:'/items'}, json=${4:{'name': 'foo'}})",
