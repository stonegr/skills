    "互斥锁": {
        "prefix": "lua_thread_lock",
        "body": [
            "-- ============ 实现：协程协作式互斥锁（仅在 coroutine 协作中有效）============",
            "-- 注意：Lua 无真线程，OS 线程需用 lua-ffi / luarings",
            "local ${1:lock} = { locked = false }",
            "local ${2:waiters} = {}",
            "",
            "function ${3:lock_acquire}(self)",
            "    if not self.locked then",
            "        self.locked = true",
            "        return",
            "    end",
            "    table.insert(self.waiters, coroutine.running())",
            "    coroutine.yield()",
            "    self.locked = true",
            "end",
            "",
            "function ${4:lock_release}(self)",
            "    self.locked = false",
            "    if #self.waiters > 0 then",
            "        local co = table.remove(self.waiters, 1)",
            "        coroutine.resume(co)",
            "    end",
            "end",
            "",
            "-- 使用",
            "$3($1)",
            "${5:-- critical section}",
            "$4($1)"
        ],
        "description": "互斥锁（协程协作式，OS 真线程需 lua-ffi / luarings）"
    },
    "读写锁": {
        "prefix": "lua_thread_rlock",
        "body": [
            "-- ============ 实现：协程协作式读写锁（多读者单写者）============",
            "local ${1:rwl} = { readers = 0, writer = false, waiters = {} }",
            "",
            "function ${2:rwl_rlock}(self)",
            "    while self.writer do",
            "        table.insert(self.waiters, { co = coroutine.running(), mode = \"r\" })",
            "        coroutine.yield()",
            "    end",
            "    self.readers = self.readers + 1",
            "end",
            "",
            "function ${3:rwl_runlock}(self)",
            "    self.readers = self.readers - 1",
            "    if self.readers == 0 then self:_wake_waiters() end",
            "end",
            "",
            "function ${4:rwl_wlock}(self)",
            "    while self.writer or self.readers > 0 do",
            "        table.insert(self.waiters, { co = coroutine.running(), mode = \"w\" })",
            "        coroutine.yield()",
            "    end",
            "    self.writer = true",
            "end",
            "",
            "function ${5:rwl_wunlock}(self)",
            "    self.writer = false",
            "    self:_wake_waiters()",
            "end",
            "",
            "function ${1:rwl}._wake_waiters(self)",
            "    local w = self.waiters",
            "    self.waiters = {}",
            "    for _, item in ipairs(w) do coroutine.resume(item.co) end",
            "end"
        ],
        "description": "读写锁（协程协作式，多读者单写者）"
    },
    "信号量": {
        "prefix": "lua_thread_semaphore",
        "body": [
            "-- ============ 实现：协程协作式计数信号量 ============",
            "local ${1:sem} = { count = ${2:3}, waiters = {} }",
            "",
            "function ${3:sem_acquire}(self)",
            "    if self.count > 0 then",
            "        self.count = self.count - 1",
            "        return",
            "    end",
            "    table.insert(self.waiters, coroutine.running())",
            "    coroutine.yield()",
            "end",
            "",
            "function ${4:sem_release}(self)",
            "    if #self.waiters > 0 then",
            "        local co = table.remove(self.waiters, 1)",
            "        coroutine.resume(co)",
            "    else",
            "        self.count = self.count + 1",
            "    end",
            "end",
            "",
            "-- 使用",
            "$3($1)",
            "${5:-- critical section}",
            "$4($1)"
        ],
        "description": "信号量（协程协作式计数信号量）"
    },
    "条件变量": {
        "prefix": "lua_thread_condition",
        "body": [
            "-- ============ 实现：协程协作式条件变量 ============",
            "local ${1:cond} = { waiters = {} }",
            "",
            "function ${2:cond_wait}(self, ${3:pred})",
            "    while not $3() do",
            "        table.insert(self.waiters, coroutine.running())",
            "        coroutine.yield()",
            "    end",
            "end",
            "",
            "function ${4:cond_signal}(self)",
            "    if #self.waiters > 0 then",
            "        coroutine.resume(table.remove(self.waiters, 1))",
            "    end",
            "end",
            "",
            "function ${5:cond_broadcast}(self)",
            "    local w = self.waiters",
            "    self.waiters = {}",
            "    for _, co in ipairs(w) do coroutine.resume(co) end",
            "end",
            "",
            "-- 使用",
            "$2($1, function() return ${6:ready} end)",
            "${7:-- after predicate true}"
        ],
        "description": "条件变量（协程协作式，signal/broadcast 唤醒等待者）"
    },
    "事件": {
        "prefix": "lua_thread_event",
        "body": [
            "-- ============ 实现：协程协作式一次性事件 ============",
            "local ${1:evt} = { signaled = false, waiters = {} }",
            "",
            "function ${2:evt_wait}(self)",
            "    if self.signaled then return end",
            "    table.insert(self.waiters, coroutine.running())",
            "    coroutine.yield()",
            "end",
            "",
            "function ${3:evt_set}(self)",
            "    self.signaled = true",
            "    local w = self.waiters",
            "    self.waiters = {}",
            "    for _, co in ipairs(w) do coroutine.resume(co) end",
            "end",
            "",
            "-- 使用",
            "$2($1)",
            "${4:-- after event set}"
        ],
        "description": "事件（协程协作式一次性事件，set 后 wait 立即返回）"
    },
    "屏障": {
        "prefix": "lua_thread_barrier",
        "body": [
            "-- ============ 实现：协程协作式屏障（N 个协程全部到齐才放行）============",
            "local ${1:bar} = { target = ${2:3}, arrived = 0, waiters = {} }",
            "",
            "function ${3:bar_wait}(self)",
            "    self.arrived = self.arrived + 1",
            "    if self.arrived >= self.target then",
            "        local w = self.waiters",
            "        self.waiters = {}",
            "        self.arrived = 0",
            "        for _, co in ipairs(w) do coroutine.resume(co) end",
            "        return",
            "    end",
            "    table.insert(self.waiters, coroutine.running())",
            "    coroutine.yield()",
            "end",
            "",
            "-- 使用",
            "$3($1)",
            "${4:-- all coroutines arrived}"
        ],
        "description": "屏障（协程协作式，N 个到齐一起放行）"
    },
