    "信号量": {
        "prefix": "go_thread_semaphore",
        "body": [
            "${1:sem} := make(chan struct{}, ${2:3})",
            "$1 <- struct{}{}",
            "${3:// critical section}",
            "<-$1"
        ],
        "description": "信号量（channel 实现）"
    },
    "条件变量": {
        "prefix": "go_thread_condition",
        "body": [
            "var ${1:cond} = sync.NewCond(&${2:mu})",
            "var ${3:queue} []${4:Item}",
            "",
            "// ============ 实现 1：waiter（消费者）============",
            "func ${5:consumer}() {",
            "    $1.L.Lock()",
            "    for len($3) == 0 {",
            "        $1.Wait()",
            "    }",
            "    item := $3[0]",
            "    $3 = $3[1:]",
            "    $1.L.Unlock()",
            "    ${6:// 处理 item}",
            "}",
            "",
            "// ============ 实现 2：notifier（生产者）============",
            "func ${7:producer}(item ${4:Item}) {",
            "    $1.L.Lock()",
            "    $3 = append($3, item)",
            "    $1.Signal()      // 唤醒一个 waiter",
            "    // $1.Broadcast()  // 唤醒所有 waiter",
            "    $1.L.Unlock()",
            "}"
        ],
        "description": "条件变量（waiter 与 notifier 拆成独立函数）"
    },
