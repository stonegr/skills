    "信号量": {
        "prefix": "rs_thread_semaphore",
        "body": [
            "// ============ 实现 1：标准库自实现（Mutex + Condvar）============",
            "use std::sync::{Arc, Condvar, Mutex};",
            "",
            "struct Semaphore {",
            "    count: Mutex<usize>,",
            "    cvar: Condvar,",
            "}",
            "",
            "impl Semaphore {",
            "    fn new(n: usize) -> Self {",
            "        Self { count: Mutex::new(n), cvar: Condvar::new() }",
            "    }",
            "",
            "    fn acquire(&self) {",
            "        let mut count = self.count.lock().unwrap();",
            "        while *count == 0 {",
            "            count = self.cvar.wait(count).unwrap();",
            "        }",
            "        *count -= 1;",
            "    }",
            "",
            "    fn release(&self) {",
            "        *self.count.lock().unwrap() += 1;",
            "        self.cvar.notify_one();",
            "    }",
            "}",
            "",
            "let ${1:sem} = Arc::new(Semaphore::new(${2:3}));",
            "",
            "",
            "// ============ 实现 2：tokio（异步，推荐生产用）============",
            "// use tokio::sync::Semaphore;",
            "// let $1 = Arc::new(Semaphore::new($2));",
            "// let _permit = $1.acquire().await;"
        ],
        "description": "信号量（std 自实现默认 + tokio 备选）"
    },
