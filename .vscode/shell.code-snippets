{
    "for 数字范围循环": {
        "prefix": "sh_for",
        "body": [
            "for ((${1:i}=${2:0}; $1 < ${3:10}; $1++)); do",
            "    ${4:# body}",
            "done"
        ],
        "description": "for 数字范围循环（C 风格）"
    },
    "for 遍历列表": {
        "prefix": "sh_for_range",
        "body": [
            "for ${1:item} in ${2:list}; do",
            "    ${3:# body}",
            "done"
        ],
        "description": "for 遍历列表"
    },
    "while 循环": {
        "prefix": "sh_while",
        "body": [
            "while [[ ${1:condition} ]]; do",
            "    ${2:# body}",
            "done"
        ],
        "description": "while 循环"
    },
    "错误处理": {
        "prefix": "sh_try",
        "body": [
            "${1:command} || { echo \"error\" >&2; ${2:exit 1}; }"
        ],
        "description": "错误处理（用 || 链）"
    },
    "输出错误并退出": {
        "prefix": "sh_throw",
        "body": [
            "echo \"${1:error message}\" >&2",
            "exit ${2:1}"
        ],
        "description": "输出错误并退出（throw）"
    },
    "错误处理函数": {
        "prefix": "sh_error_define",
        "body": [
            "${1:err_handler}() {",
            "    echo \"${2:message}\" >&2",
            "    return ${3:1}",
            "}"
        ],
        "description": "错误处理函数"
    },
    "if 判断": {
        "prefix": "sh_if",
        "body": [
            "if [[ ${1:condition} ]]; then",
            "    ${2:# body}",
            "elif [[ ${3:condition} ]]; then",
            "    ${4:# body}",
            "else",
            "    ${5:# body}",
            "fi"
        ],
        "description": "if 判断"
    },
    "读取文件": {
        "prefix": "sh_read_file",
        "body": [
            "while IFS= read -r ${1:line}; do",
            "    ${2:echo \"\\$line\"}",
            "done < ${3:file}"
        ],
        "description": "读取文件（按行）"
    },
    "读取环境变量": {
        "prefix": "sh_read_env",
        "body": [
            "${1:value}=\\${${2:KEY}:-${3:default}}"
        ],
        "description": "读取环境变量"
    },
    "命令替换": {
        "prefix": "sh_shell",
        "body": [
            "${1:output}=${2:$(command)}"
        ],
        "description": "命令替换"
    },
    "获取程序运行耗时": {
        "prefix": "sh_time",
        "body": [
            "start=\\$(date +%s%N)",
            "${1:# code}",
            "end=\\$(date +%s%N)",
            "echo \"耗时: \\$(( (end - start) / 1000000 ))ms\""
        ],
        "description": "获取程序运行耗时"
    },
    "获取当前目录": {
        "prefix": "sh_cwd",
        "body": [
            "${1:dir}=$(pwd)"
        ],
        "description": "获取当前目录"
    },
    "命令行参数": {
        "prefix": "sh_args",
        "body": [
            "while getopts \"${1:o:vh}\" opt; do",
            "    case \"\\$opt\" in",
            "        ${2:o})",
            "            ${3:echo \"option -\\$opt with arg \\$OPTARG\"}",
            "            ;;",
            "        h)",
            "            ${4:usage}",
            "            ;;",
            "        *)",
            "            ${5:exit 1}",
            "            ;;",
            "    esac",
            "done"
        ],
        "description": "命令行参数 (getopts)"
    },
    "获取用户输入": {
        "prefix": "sh_input",
        "body": [
            "read -p \"${1:请输入}: \" ${2:input}"
        ],
        "description": "获取用户输入"
    },
    "文件锁": {
        "prefix": "sh_thread_lock",
        "body": [
            "${1:lock_file}=$(mktemp)",
            "exec 200>\\$${1:lock_file}",
            "flock -x 200",
            "${2:# critical section}",
            "exec 200>&-"
        ],
        "description": "文件锁（flock）"
    },
    "读写锁": {
        "prefix": "sh_thread_rlock",
        "body": [
            "# Shell 无内置读写锁，可用 flock 配合两个文件实现"
        ],
        "description": "读写锁（flock 模拟）"
    },
    "信号量": {
        "prefix": "sh_thread_semaphore",
        "body": [
            "# Shell 信号量：用 mkdir 原子性实现互斥，循环控制并发数",
            "${1:dir}=$(mktemp -d)",
            "while ! mkdir \"\\$${1:dir}/lock\" 2>/dev/null; do sleep 0.1; done",
            "${2:# critical section}",
            "rmdir \"\\$${1:dir}/lock\""
        ],
        "description": "信号量（基于文件）"
    },
    "条件变量": {
        "prefix": "sh_thread_condition",
        "body": [
            "# ============ 实现 1：文件轮询（跨平台，简单）============",
            "# 注意：Shell 无 notify() / notify_all() 区分",
            "# 任何进程 touch 事件文件，所有等待者都会被唤醒",
            "${1:event_file}=$(mktemp)",
            "# 触发方：touch ${2:$1}",
            "while [[ ! -f ${3:$2} ]]; do sleep 0.1; done",
            "",
            "",
            "# ============ 实现 2：inotifywait（Linux 专属，事件驱动不占 CPU）============",
            "# ${1:event_file}=$(mktemp)",
            "# inotifywait -e modify \"${2:$1}\""
        ],
        "description": "条件变量（文件轮询 + inotifywait 备选）"
    },
    "事件": {
        "prefix": "sh_thread_event",
        "body": [
            "# Shell 事件：用文件存在与否作为信号",
            "${1:event_file}=$(mktemp)",
            "# 触发方: touch \\$${1:event_file}",
            "while [[ ! -f \\$${1:event_file} ]]; do sleep 0.1; done"
        ],
        "description": "事件（基于文件）"
    },
    "屏障": {
        "prefix": "sh_thread_barrier",
        "body": [
            "wait"
        ],
        "description": "屏障（wait 所有后台进程）"
    },
    "后台进程": {
        "prefix": "sh_process",
        "body": [
            "${1:command} &",
            "pid=\\$!",
            "wait \\$pid"
        ],
        "description": "后台进程"
    },
    "日志打印": {
        "prefix": "sh_log",
        "body": [
            "echo \"[\\$(date '+%Y-%m-%d %H:%M:%S')] ${1:level}: ${2:message}\" | tee -a ${3:log_file}"
        ],
        "description": "日志打印（带时间戳）"
    },
    "读取 JSON 配置文件": {
        "prefix": "sh_read_json",
        "body": [
            "${1:value}=$(jq -r ${2:.path.to.value} ${3:config.json})"
        ],
        "description": "读取 JSON 配置文件 (jq)"
    },
    "信号监听": {
        "prefix": "sh_signal",
        "body": [
            "trap '${1:echo \"收到信号\"; cleanup; exit 0}' ${2|SIGHUP,SIGINT,SIGTERM|}"
        ],
        "description": "信号监听（trap）"
    },
    "写入文件": {
        "prefix": "sh_write_file",
        "body": [
            "cat > ${1:path} << 'EOF'",
            "    ${2:content}",
            "EOF",
            "sed -i 's/^\\ \\ \\ \\ \\ \\ \\ \\ //g' $1"
        ],
        "description": "写入文件（多行）"
    },
    "拷贝文件": {
        "prefix": "sh_copy_file",
        "body": [
            "# -P 表示直接复制链接而不是跟随链接复制",
            "cp ${1:src} ${2:dst}"
        ],
        "description": "拷贝文件"
    },
    "移动/重命名文件": {
        "prefix": "sh_move_file",
        "body": [
            "mv ${1:src} ${2:dst}"
        ],
        "description": "移动/重命名文件"
    },
    "删除文件": {
        "prefix": "sh_delete_file",
        "body": [
            "rm ${1:path}"
        ],
        "description": "删除文件"
    },
    "时间等待": {
        "prefix": "sh_sleep",
        "body": [
            "sleep ${1:seconds}"
        ],
        "description": "时间等待（秒）"
    },
    "生成随机字符串": {
        "prefix": "sh_random_string",
        "body": [
            "# ============ 实现 1：/dev/urandom + tr（密码学安全，Linux/Mac）============",
            "${1:str}=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c ${2:16})",
            "",
            "",
            "# ============ 实现 2：openssl rand（更可控，可指定字符集）============",
            "# ${1:str}=$(openssl rand -base64 ${3:24} | tr -d '=+/' | cut -c1-${2:16})"
        ],
        "description": "生成随机字符串（/dev/urandom 默认 + openssl 备选）"
    },
    "函数定义": {
        "prefix": "sh_function",
        "body": [
            "${1:name}() {",
            "    ${2:# body}",
            "}"
        ],
        "description": "函数定义"
    },
    // 下面为测试snippets
    "基本测试": {
        "prefix": "sh_test_func",
        "body": [
            "@test \"${1:test name}\" {",
            "    ${2:# test body}",
            "    [ \"\\$status\" -eq 0 ]",
            "}"
        ],
        "description": "基本测试函数（bats）"
    },
    "命名测试": {
        "prefix": "sh_test_named",
        "body": [
            "@test \"${1:group}: ${2:case}\" {",
            "    ${3:# test body}",
            "}"
        ],
        "description": "命名测试（带分组前缀）"
    },
    "跳过测试": {
        "prefix": "sh_test_skip",
        "body": [
            "@test \"${1:test name}\" {",
            "    skip \"${2:reason}\"",
            "}"
        ],
        "description": "skip 跳过测试"
    },
    "条件跳过": {
        "prefix": "sh_test_skip_if",
        "body": [
            "@test \"${1:test name}\" {",
            "    [ \"${2:condition}\" ] && skip \"${3:reason}\"",
            "    ${4:# test body}",
            "}"
        ],
        "description": "条件满足时跳过（skip_if）"
    },
    "加载辅助文件": {
        "prefix": "sh_test_load_helper",
        "body": [
            "# 加载公共辅助函数",
            "load '${1:helpers/test_helper.bash}'"
        ],
        "description": "load 辅助函数文件"
    },
    "相等断言": {
        "prefix": "sh_test_eq",
        "body": [
            "[ \"${1:actual}\" = \"${2:expected}\" ]"
        ],
        "description": "字符串相等断言"
    },
    "不等断言": {
        "prefix": "sh_test_ne",
        "body": [
            "[ \"${1:actual}\" != \"${2:expected}\" ]"
        ],
        "description": "字符串不等断言"
    },
    "真值断言": {
        "prefix": "sh_test_true",
        "body": [
            "[ \"${1:condition}\" ]"
        ],
        "description": "真值断言（test 命令）"
    },
    "匹配断言": {
        "prefix": "sh_test_contains",
        "body": [
            "[[ \"${1:string}\" =~ ${2:pattern} ]]"
        ],
        "description": "正则匹配断言"
    },
    "退出码断言": {
        "prefix": "sh_test_status",
        "body": [
            "[ \"\\$status\" -eq ${1:0} ]"
        ],
        "description": "退出码断言"
    },
    "错误退出断言": {
        "prefix": "sh_test_err",
        "body": [
            "run ${1:command}",
            "[ \"\\$status\" -ne 0 ]",
            "[ \"${2:output}\" = \"${3:expected_err_msg}\" ]"
        ],
        "description": "命令返回非零 + 错误消息匹配"
    },
    "setup_file 前置": {
        "prefix": "sh_test_setup_file",
        "body": [
            "setup_file() {",
            "    ${1:# 整个文件第一个测试前}",
            "}",
            "",
            "teardown_file() {",
            "    ${2:# 整个文件最后一个测试后}",
            "}"
        ],
        "description": "setup_file / teardown_file（每文件）"
    },
    "setup_test 前置": {
        "prefix": "sh_test_setup_test",
        "body": [
            "setup() {",
            "    ${1:# 每个测试前}",
            "}",
            "",
            "teardown() {",
            "    ${2:# 每个测试后}",
            "}"
        ],
        "description": "setup / teardown（每用例）"
    },
    "全局 setup": {
        "prefix": "sh_test_setup",
        "body": [
            "setup() {",
            "    ${1:# 全局初始化}",
            "}"
        ],
        "description": "全局 setup 初始化"
    },
    "全局 teardown": {
        "prefix": "sh_test_teardown",
        "body": [
            "teardown() {",
            "    ${1:# 全局清理}",
            "}"
        ],
        "description": "全局 teardown 清理"
    },
    "for 循环参数化": {
        "prefix": "sh_test_param_for",
        "body": [
            "@test \"${1:group}: ${2:case}\" {",
            "    for ${3:case} in ${4:1 2 3}; do",
            "        run ${5:func $3}",
            "        [ \"\\$status\" -eq 0 ]",
            "        [ \"\\$output\" = \"$3\" ]",
            "    done",
            "}"
        ],
        "description": "for 循环跑多组用例"
    },
    "数组参数化": {
        "prefix": "sh_test_param_arr",
        "body": [
            "declare -a ${1:cases}=(\"${2:a}\" \"${3:b}\" \"${4:c}\")",
            "for ${5:case} in \"${${1:cases}[@]}\"; do",
            "    @test \"$5: $5\" {",
            "        run ${6:func $5}",
            "        [ \"\\$status\" -eq 0 ]",
            "    }",
            "done"
        ],
        "description": "数组 + 循环生成多测试"
    },
    "data 文件参数化": {
        "prefix": "sh_test_param_data",
        "body": [
            "while IFS='${1::}' read -r ${2:input} ${3:expected}; do",
            "    @test \"test $2 -> $3\" {",
            "        run ${4:func $2}",
            "        [ \"\\$output\" = \"$3\" ]",
            "    }",
            "done < ${5:testdata.csv}"
        ],
        "description": "从数据文件读取参数化"
    },
    "source 引入 stub": {
        "prefix": "sh_test_source",
        "body": [
            "# 引入 stub 替换原命令",
            "source ${1:test/stubs/cmd_stub.sh}"
        ],
        "description": "source 引入 stub 文件"
    },
    "重定义函数 stub": {
        "prefix": "sh_test_function_mock",
        "body": [
            "# 重定义函数为 stub",
            "${1:func_name}() {",
            "    echo \"${2:stubbed}\"",
            "}"
        ],
        "description": "重定义函数为 stub"
    },
    "环境变量 mock": {
        "prefix": "sh_test_env_mock",
        "body": [
            "export ${1:KEY}=\"${2:value}\""
        ],
        "description": "测试环境变量设置"
    },
    "run 捕获输出": {
        "prefix": "sh_test_run",
        "body": [
            "run ${1:command}",
            "echo \"\\$output\"",
            "[ \"\\$status\" -eq ${2:0} ]"
        ],
        "description": "run 命令并捕获输出"
    },
    "退出码校验": {
        "prefix": "sh_test_status_check",
        "body": [
            "run ${1:command}",
            "[ \"\\$status\" -eq ${2:0} ]"
        ],
        "description": "run + status 校验"
    },
    "输出内容校验": {
        "prefix": "sh_test_output_check",
        "body": [
            "run ${1:command}",
            "[[ \"\\$output\" =~ \"${2:pattern}\" ]]"
        ],
        "description": "run + output 校验"
    },
    "bats-assert 扩展断言": {
        "prefix": "sh_test_bats_assert",
        "body": [
            "load '${1:test_helper.bash}'",
            "",
            "@test \"${2:test name}\" {",
            "    run ${3:command}",
            "    assert_success",
            "    assert_output \"${4:expected}\"",
            "}"
        ],
        "description": "bats-assert 扩展断言（assert_success 等）"
    },
    "bats-support 辅助": {
        "prefix": "sh_test_bats_support",
        "body": [
            "load '${1:test_helper/common-setup.bash}'",
            "",
            "common_setup() {",
            "    load '${2:test_helper.bash}'",
            "}",
            "common_teardown() {",
            "    ${3:# cleanup}",
            "}"
        ],
        "description": "bats-support 通用辅助"
    },
    "并行运行": {
        "prefix": "sh_test_parallel",
        "body": [
            "bats --jobs ${1:4} ${2:tests/}"
        ],
        "description": "bats --jobs N 并行"
    },
    "过滤测试": {
        "prefix": "sh_test_filter",
        "body": [
            "bats --filter ${1:regex} ${2:tests/}"
        ],
        "description": "bats --filter 正则过滤"
    },
    "kcov 覆盖率": {
        "prefix": "sh_test_cover",
        "body": [
            "# 使用 kcov 跑覆盖率",
            "kcov --include-pattern=${1:src/} coverage/ bats ${2:tests/}"
        ],
        "description": "kcov 覆盖率（shell 测试）"
    },
    "export 测试环境": {
        "prefix": "sh_test_export_env",
        "body": [
            "export ${1:ENV_VAR}=\"${2:test_value}\"",
            "export ${3:ANOTHER_VAR}=\"${4:value}\""
        ],
        "description": "批量 export 测试环境变量"
    }
}