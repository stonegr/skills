{
    "for 数字范围循环": {
        "prefix": "sh_for",
        "body": [
            "for ((${1:i}=${2:0}; $1 < ${3:10}; $1++)); do",
            "    ${4:# body}",
            "done"
        ],
        "description": "for 数字范围循环（C 风格）"
    },
    "for 遍历列表": {
        "prefix": "sh_for_range",
        "body": [
            "for ${1:item} in ${2:list}; do",
            "    ${3:# body}",
            "done"
        ],
        "description": "for 遍历列表"
    },
    "while 循环": {
        "prefix": "sh_while",
        "body": [
            "while [[ ${1:condition} ]]; do",
            "    ${2:# body}",
            "done"
        ],
        "description": "while 循环"
    },
    "错误处理": {
        "prefix": "sh_try",
        "body": [
            "${1:command} || { echo \"error\" >&2; ${2:exit 1}; }"
        ],
        "description": "错误处理（用 || 链）"
    },
    "输出错误并退出": {
        "prefix": "sh_throw",
        "body": [
            "echo \"${1:error message}\" >&2",
            "exit ${2:1}"
        ],
        "description": "输出错误并退出（throw）"
    },
    "错误处理函数": {
        "prefix": "sh_error_define",
        "body": [
            "${1:err_handler}() {",
            "    echo \"${2:message}\" >&2",
            "    return ${3:1}",
            "}"
        ],
        "description": "错误处理函数"
    },
    "if 判断": {
        "prefix": "sh_if",
        "body": [
            "if [[ ${1:condition} ]]; then",
            "    ${2:# body}",
            "elif [[ ${3:condition} ]]; then",
            "    ${4:# body}",
            "else",
            "    ${5:# body}",
            "fi"
        ],
        "description": "if 判断"
    },
    "读取文件": {
        "prefix": "sh_read_file",
        "body": [
            "while IFS= read -r ${1:line}; do",
            "    ${2:echo \"$line\"}",
            "done < ${3:file}"
        ],
        "description": "读取文件（按行）"
    },
    "读取环境变量": {
        "prefix": "sh_read_env",
        "body": [
            "${1:value}=\\${${2:KEY}:-${3:default}}"
        ],
        "description": "读取环境变量"
    },
    "命令替换": {
        "prefix": "sh_shell",
        "body": [
            "${1:output}=${2:$(command)}"
        ],
        "description": "命令替换"
    },
    "获取程序运行耗时": {
        "prefix": "sh_time",
        "body": [
            "start=\\$(date +%s%N)",
            "${1:# code}",
            "end=\\$(date +%s%N)",
            "echo \"耗时: \\$(( (end - start) / 1000000 ))ms\""
        ],
        "description": "获取程序运行耗时"
    },
    "获取当前目录": {
        "prefix": "sh_cwd",
        "body": [
            "${1:dir}=$(pwd)"
        ],
        "description": "获取当前目录"
    },
    "命令行参数": {
        "prefix": "sh_args",
        "body": [
            "while getopts \"${1:o:vh}\" opt; do",
            "    case \"$opt\" in",
            "        ${2:o})",
            "            ${3:echo \"option -$opt with arg $OPTARG\"}",
            "            ;;",
            "        h)",
            "            ${4:usage}",
            "            ;;",
            "        *)",
            "            ${5:exit 1}",
            "            ;;",
            "    esac",
            "done"
        ],
        "description": "命令行参数 (getopts)"
    },
    "获取用户输入": {
        "prefix": "sh_input",
        "body": [
            "read -p \"${1:请输入}: \" ${2:input}"
        ],
        "description": "获取用户输入"
    },
    "文件锁": {
        "prefix": "sh_thread_lock",
        "body": [
            "${1:lock_file}=$(mktemp)",
            "exec 200>\\$${1:lock_file}",
            "flock -x 200",
            "${2:# critical section}",
            "exec 200>&-"
        ],
        "description": "文件锁（flock）"
    },
    "读写锁": {
        "prefix": "sh_thread_rlock",
        "body": [
            "# Shell 无内置读写锁，可用 flock 配合两个文件实现"
        ],
        "description": "读写锁（flock 模拟）"
    },
    "信号量": {
        "prefix": "sh_thread_semaphore",
        "body": [
            "# Shell 信号量：用 mkdir 原子性实现互斥，循环控制并发数",
            "${1:dir}=$(mktemp -d)",
            "while ! mkdir \"\\$${1:dir}/lock\" 2>/dev/null; do sleep 0.1; done",
            "${2:# critical section}",
            "rmdir \"\\$${1:dir}/lock\""
        ],
        "description": "信号量（基于文件）"
    },
    "条件变量": {
        "prefix": "sh_thread_condition",
        "body": [
            "# ============ 实现 1：文件轮询（跨平台，简单）============",
            "# 注意：Shell 无 notify() / notify_all() 区分",
            "# 任何进程 touch 事件文件，所有等待者都会被唤醒",
            "${1:event_file}=$(mktemp)",
            "# 触发方：touch ${2:$1}",
            "while [[ ! -f ${3:$2} ]]; do sleep 0.1; done",
            "",
            "",
            "# ============ 实现 2：inotifywait（Linux 专属，事件驱动不占 CPU）============",
            "# ${1:event_file}=$(mktemp)",
            "# inotifywait -e modify \"${2:$1}\""
        ],
        "description": "条件变量（文件轮询 + inotifywait 备选）"
    },
    "事件": {
        "prefix": "sh_thread_event",
        "body": [
            "# Shell 事件：用文件存在与否作为信号",
            "${1:event_file}=$(mktemp)",
            "# 触发方: touch \\$${1:event_file}",
            "while [[ ! -f \\$${1:event_file} ]]; do sleep 0.1; done"
        ],
        "description": "事件（基于文件）"
    },
    "屏障": {
        "prefix": "sh_thread_barrier",
        "body": [
            "wait"
        ],
        "description": "屏障（wait 所有后台进程）"
    },
    "后台进程": {
        "prefix": "sh_process",
        "body": [
            "${1:command} &",
            "pid=\\$!",
            "wait \\$pid"
        ],
        "description": "后台进程"
    },
    "日志打印": {
        "prefix": "sh_log",
        "body": [
            "echo \"[\\$(date '+%Y-%m-%d %H:%M:%S')] ${1:level}: ${2:message}\" | tee -a ${3:log_file}"
        ],
        "description": "日志打印（带时间戳）"
    },
    "读取 JSON 配置文件": {
        "prefix": "sh_read_json",
        "body": [
            "${1:value}=$(jq -r ${2:.path.to.value} ${3:config.json})"
        ],
        "description": "读取 JSON 配置文件 (jq)"
    },
    "信号监听": {
        "prefix": "sh_signal",
        "body": [
            "trap '${1:echo \"收到信号\"; cleanup; exit 0}' ${2|SIGHUP,SIGINT,SIGTERM|}"
        ],
        "description": "信号监听（trap）"
    },
    "写入文件": {
        "prefix": "sh_write_file",
        "body": [
            "cat > ${1:path} << 'EOF'",
            "${2:content}",
            "EOF"
        ],
        "description": "写入文件（多行）"
    },
    "拷贝文件": {
        "prefix": "sh_copy_file",
        "body": [
            "# -P 表示直接复制链接而不是跟随链接复制",
            "cp ${1:src} ${2:dst}"
        ],
        "description": "拷贝文件"
    },
    "移动/重命名文件": {
        "prefix": "sh_move_file",
        "body": [
            "mv ${1:src} ${2:dst}"
        ],
        "description": "移动/重命名文件"
    },
    "删除文件": {
        "prefix": "sh_delete_file",
        "body": [
            "rm ${1:path}"
        ],
        "description": "删除文件"
    },
    "时间等待": {
        "prefix": "sh_sleep",
        "body": [
            "sleep ${1:seconds}"
        ],
        "description": "时间等待（秒）"
    },
    "生成随机字符串": {
        "prefix": "sh_random_string",
        "body": [
            "# ============ 实现 1：/dev/urandom + tr（密码学安全，Linux/Mac）============",
            "${1:str}=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c ${2:16})",
            "",
            "",
            "# ============ 实现 2：openssl rand（更可控，可指定字符集）============",
            "# ${1:str}=$(openssl rand -base64 ${3:24} | tr -d '=+/' | cut -c1-${2:16})"
        ],
        "description": "生成随机字符串（/dev/urandom 默认 + openssl 备选）"
    }
}
