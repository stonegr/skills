  "sa_relationship": {
    "prefix": "sa_relationship",
    "body": [
      "from sqlalchemy import Column, Integer, ForeignKey",
      "from sqlalchemy.orm import relationship",
      "from ${1:your_module} import Base",
      "",
      "class ${2:User}(Base):",
      "    __tablename__ = '${3:users}'",
      "    id = Column(Integer, primary_key=True)",
      "    ${4:posts} = relationship('${5:Post}', back_populates='${6:user}', cascade='all, delete-orphan')",
      "",
      "class ${5:Post}(Base):",
      "    __tablename__ = '${7:posts}'",
      "    id = Column(Integer, primary_key=True)",
      "    user_id = Column(Integer, ForeignKey('${3:users}.id'))",
      "    ${6:user} = relationship('${2:User}', back_populates='${4:posts}')"
    ],
    "description": "一对多关系 relationship"
  },
  "sa_many_to_many": {
    "prefix": "sa_many_to_many",
    "body": [
      "from sqlalchemy import Column, Integer, Table, ForeignKey",
      "from sqlalchemy.orm import relationship",
      "from ${1:your_module} import Base",
      "",
      "${2:user_tag} = Table(",
      "    '${3:user_tag}', Base.metadata,",
      "    Column('user_id', Integer, ForeignKey('${4:users}.id'), primary_key=True),",
      "    Column('tag_id', Integer, ForeignKey('${5:tags}.id'), primary_key=True),",
      ")",
      "",
      "class ${6:User}(Base):",
      "    __tablename__ = '${4:users}'",
      "    id = Column(Integer, primary_key=True)",
      "    ${7:tags} = relationship('${8:Tag}', secondary=${2:user_tag}, back_populates='${9:users}')",
      "",
      "class ${8:Tag}(Base):",
      "    __tablename__ = '${5:tags}'",
      "    id = Column(Integer, primary_key=True)",
      "    ${9:users} = relationship('${6:User}', secondary=${2:user_tag}, back_populates='${7:tags}')"
    ],
    "description": "多对多关系 secondary"
  },
