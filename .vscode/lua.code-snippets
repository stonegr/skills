    "屏障": {
        "prefix": "lua_thread_barrier",
        "body": [
            "-- ============ 实现：协程协作式屏障（N 个协程全部到齐才放行）============",
            "local ${1:bar} = { target = ${2:3}, arrived = 0, waiters = {} }",
            "",
            "function ${3:bar_wait}(self)",
            "    self.arrived = self.arrived + 1",
            "    if self.arrived >= self.target then",
            "        local w = self.waiters",
            "        self.waiters = {}",
            "        self.arrived = 0",
            "        for _, co in ipairs(w) do coroutine.resume(co) end",
            "        return",
            "    end",
            "    table.insert(self.waiters, coroutine.running())",
            "    coroutine.yield()",
            "end",
            "",
            "-- 使用",
            "$3($1)",
            "${4:-- all coroutines arrived}"
        ],
        "description": "屏障（协程协作式，N 个到齐一起放行）"
    },
