# 环境变量配置模板
# 使用APP_前缀，嵌套用下划线分隔

# 应用基础配置
APP_NAME="My App"
APP_ENV="development"
APP_ROOT_PATH="."

# 服务器配置
APP_SERVER_HOST="0.0.0.0"
APP_SERVER_PORT=8000

# 日志配置
APP_LOG_LEVEL="INFO"
APP_LOG_FILE="./logs/app.log"
APP_LOG_OUTPUT="both"
APP_LOG_MAX_SIZE=100
APP_LOG_MAX_BACKUPS=7
APP_LOG_MAX_AGE=30
APP_LOG_COMPRESS=true

# 数据库配置
APP_DATABASE_HOST="localhost"
APP_DATABASE_PORT=5432
APP_DATABASE_USER="postgres"
APP_DATABASE_PASSWORD="CHANGEME"
APP_DATABASE_NAME="template_db"

# Redis配置
APP_REDIS_HOST="localhost"
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=""
APP_REDIS_DB=0

# JWT配置
APP_JWT_SECRET="CHANGEME"
APP_JWT_ACCESS_EXPIRE=60
APP_JWT_REFRESH_EXPIRE=10080

# 跨域配置
APP_CORS_ORIGINS="http://localhost:3000,http://localhost:8000"