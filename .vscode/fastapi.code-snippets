        ],
        "description": "TestClient 测试 POST 接口"
    },
    "httpx 异步接口测试": {
        "prefix": "fa_async_test",
        "body": [
            "import httpx",
            "import pytest",
            "from fastapi import FastAPI",
            "",
            "app = FastAPI()",
            "",
            "@app.get(${1:'/'})",
            "async def ${2:read_root}():",
            "    return ${3:{'hello': 'world'}}",
            "",
            "@pytest.mark.asyncio",
            "async def ${4:test_async}():",
            "    async with httpx.AsyncClient(app=app, base_url=${5:'http://test'}) as client:",
            "        response = await client.get(${1:'/'})",
            "        assert response.status_code == ${6:200}"
        ],
        "description": "httpx 异步接口测试"
    },
