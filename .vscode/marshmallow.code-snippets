{
    "定义最简 Schema 类": {
        "prefix": "ms_schema_basic",
        "body": [
            "from marshmallow import Schema",
            "",
            "class ${1:MySchema}(Schema):",
            "    pass"
        ],
        "description": "定义最简 Schema 类"
    },
    "定义带字段的 Schema": {
        "prefix": "ms_schema_fields",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:name} = fields.${3|Str,Int,Float,Bool|}()"
        ],
        "description": "定义带字段的 Schema"
    },
    "用 class Meta 配置 Schema 字段": {
        "prefix": "ms_schema_meta",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:field1} = fields.${3|Str,Int,Float|}()",
            "    ${4:field2} = fields.${5|Str,Int,Float|}()",
            "",
            "    class Meta:",
            "        fields = (${6:'field1'}, ${7:'field2'})",
            "        ordered = True"
        ],
        "description": "用 class Meta 配置 Schema 字段"
    },
    "反序列化": {
        "prefix": "ms_schema_load",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:name} = fields.${3:Str}()",
            "",
            "${4:result} = ${1:MySchema}().load(${5:data})"
        ],
        "description": "反序列化（dict 校验后转 dict）"
    },
    "序列化": {
        "prefix": "ms_schema_dump",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:name} = fields.${3:Str}()",
            "",
            "${4:result} = ${1:MySchema}().dump(${5:obj})"
        ],
        "description": "序列化（对象转 dict）"
    },
