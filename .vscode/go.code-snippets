            "func ${2:randSeq}(n int) string {",
            "    b := make([]rune, n)",
            "    for i := range b {",
            "        idx, _ := rand.Int(rand.Reader, big.NewInt(int64(len($1))))",
            "        b[i] = $1[idx.Int64()]",
            "    }",
            "    return string(b)",
