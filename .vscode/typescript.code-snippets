        "prefix": "ts_thread_condition",
        "body": [
            "// ============ 实现 1：async-mutex 的 Condition（推荐，需 npm install async-mutex）============",
            "import { Condition } from 'async-mutex'",
            "const ${1:cond} = new Condition()",
            "",
            "// waiter（消费者）",
            "async function ${2:waiter}() {",
            "    while (!${3:条件}) {",
            "        await $1.wait()",
            "    }",
            "    ${4:// 条件满足后的处理}",
            "}",
            "",
            "// notifier（生产者）：改变条件后通知",
            "function ${5:notifier}() {",
            "    ${6:// 改变条件}",
            "    $1.notify()       // 唤醒一个 waiter",
            "    // $1.notifyAll()  // 唤醒所有 waiter",
            "}",
            "",
            "",
            "// ============ 实现 2：EventEmitter 模拟（无依赖，但不是真正的 Condition）============",
            "// import { EventEmitter } from 'events'",
            "// const $1 = new EventEmitter()",
            "// $1.on('${7:signal}', () => {",
            "//     ${4:// wait for signal}",
            "//     $1.emit('${8:continue}')",
            "// })"
        ],
