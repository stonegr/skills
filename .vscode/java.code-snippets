    "信号量 Semaphore": {
        "prefix": "ja_thread_semaphore",
        "body": [
            "Semaphore ${1:semaphore} = new Semaphore(${2:permits});",
            "${1:semaphore}.acquire();",
            "try {",
            "    $3",
            "} finally {",
            "    ${1:semaphore}.release();",
            "}"
        ],
        "description": "信号量 Semaphore（需要 java.util.concurrent.Semaphore）"
    },
    "条件变量 Condition": {
        "prefix": "ja_thread_condition",
        "body": [
            "ReentrantLock ${1:lock} = new ReentrantLock();",
            "Condition ${2:condition} = ${1:lock}.newCondition();",
            "${1:lock}.lock();",
            "try {",
            "    while (!${3:predicate}) {",
            "        ${2:condition}.await();",
            "    }",
            "    $4",
            "} finally {",
            "    ${1:lock}.unlock();",
            "}"
        ],
        "description": "条件变量 Condition（需要 java.util.concurrent.locks.*）"
    },
