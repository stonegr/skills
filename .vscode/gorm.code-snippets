    "连接 MySQL 数据库": {
        "prefix": "gm_connect",
        "body": [
            "import \"gorm.io/gorm\"",
            "import \"gorm.io/driver/mysql\"",
            "",
            "dsn := ${1:\"user:pass@tcp(127.0.0.1:3306)/dbname?charset=utf8mb4&parseTime=True&loc=Local\"}",
            "db, err := gorm.Open(mysql.Open(dsn), &gorm.Config{})",
            "if err != nil {",
            "\tpanic(\"failed to connect database\")",
            "}",
            "${0:sqlDB, _ := db.DB()}"
        ],
        "description": "连接 MySQL 数据库"
    },
