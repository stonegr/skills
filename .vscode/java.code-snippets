{
    "ja_for": {
        "prefix": "ja_for",
        "body": [
            "for (int ${1:i} = ${2:0}; ${1:i} < ${3:n}; ${1:i}++) {",
            "    ${4:// body}",
            "}"
        ],
        "description": "Java for 数字范围循环"
    },
    "ja_for_range": {
        "prefix": "ja_for_range",
        "body": [
            "for (${1:String} ${2:item} : ${3:collection}) {",
            "    ${4:// body}",
            "}"
        ],
        "description": "Java for-each 遍历集合"
    },
    "ja_while": {
        "prefix": "ja_while",
        "body": [
            "while (${1:condition}) {",
            "    ${2:// body}",
            "}"
        ],
        "description": "Java while 循环"
    },
    "ja_try": {
        "prefix": "ja_try",
        "body": [
            "try {",
            "    ${1:// code}",
            "} catch (${2:Exception} ${3:e}) {",
            "    ${4:// handle}",
            "} finally {",
            "    ${5:// cleanup}",
            "}"
        ],
        "description": "Java try-catch-finally 错误捕获"
    },
    "ja_throw": {
        "prefix": "ja_throw",
        "body": [
            "throw new ${1:IllegalArgumentException}(${2:\"message\"});"
        ],
        "description": "Java 抛出异常"
    },
    "ja_error_define": {
        "prefix": "ja_error_define",
        "body": [
            "public class ${1:MyException} extends ${2:Exception} {",
            "    public ${1:MyException}(String message) {",
            "        super(message);",
            "    }",
            "}"
        ],
        "description": "Java 自定义异常类"
    },
    "ja_if": {
        "prefix": "ja_if",
        "body": [
            "if (${1:condition}) {",
            "    ${2:// code}",
            "} else {",
            "    $0",
            "}"
        ],
        "description": "Java if 判断"
    },
    "ja_read_file": {
        "prefix": "ja_read_file",
        "body": [
            "String ${1:content} = Files.readString(Path.of(\"${2:path}\"));"
        ],
        "description": "Java 读取文件为字符串（需要 java.nio.file.*）"
    },
    "ja_write_file": {
        "prefix": "ja_write_file",
        "body": [
            "Files.writeString(Path.of(\"${1:path}\"), ${2:content});"
        ],
        "description": "Java 写入字符串到文件（需要 java.nio.file.*）"
    },
    "ja_copy_file": {
        "prefix": "ja_copy_file",
        "body": [
            "Files.copy(Path.of(\"${1:src}\"), Path.of(\"${2:dst}\"), StandardCopyOption.REPLACE_EXISTING);"
        ],
        "description": "Java 拷贝文件（需要 java.nio.file.*）"
    },
    "ja_move_file": {
        "prefix": "ja_move_file",
        "body": [
            "Files.move(Path.of(\"${1:src}\"), Path.of(\"${2:dst}\"), StandardCopyOption.REPLACE_EXISTING);"
        ],
        "description": "Java 移动/重命名文件（需要 java.nio.file.*）"
    },
    "ja_delete_file": {
        "prefix": "ja_delete_file",
        "body": [
            "Files.delete(Path.of(\"${1:path}\"));"
        ],
        "description": "Java 删除文件（需要 java.nio.file.*）"
    },
    "ja_read_env": {
        "prefix": "ja_read_env",
        "body": [
            "String ${1:value} = System.getenv(\"${2:VAR_NAME}\");"
        ],
        "description": "Java 读取环境变量"
    },
    "ja_read_json": {
        "prefix": "ja_read_json",
        "body": [
            "Gson gson = new Gson();",
            "${1:MyClass} ${2:config} = gson.fromJson(new FileReader(\"${3:config.json}\"), ${1:MyClass}.class);"
        ],
        "description": "Java 读取 JSON 配置文件（使用 Gson，需要 com.google.gson.* 和 java.io.FileReader）"
    },
    "ja_shell": {
        "prefix": "ja_shell",
        "body": [
            "Process ${1:process} = new ProcessBuilder(\"${2:cmd}\", \"${3:arg1}\").start();",
            "try (BufferedReader ${4:reader} = new BufferedReader(new InputStreamReader(${1:process}.getInputStream()))) {",
            "    String line;",
            "    while ((line = ${4:reader}.readLine()) != null) {",
            "        System.out.println(line);",
            "    }",
            "    int ${5:exitCode} = ${1:process}.waitFor();",
            "}"
        ],
        "description": "Java 执行 shell 命令并捕获输出（需要 java.io.*）"
    },
    "ja_time": {
        "prefix": "ja_time",
        "body": [
            "long ${1:startTime} = System.nanoTime();",
            "${2:// code}",
            "long ${3:durationMs} = (System.nanoTime() - ${1:startTime}) / 1_000_000;"
        ],
        "description": "Java 计算程序耗时（毫秒）"
    },
    "ja_sleep": {
        "prefix": "ja_sleep",
        "body": [
            "Thread.sleep(${1:1000});"
        ],
        "description": "Java 线程休眠（毫秒）"
    },
    "ja_random_string": {
        "prefix": "ja_random_string",
        "body": [
            "String chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\";",
            "Random random = new Random();",
            "StringBuilder sb = new StringBuilder(${1:length});",
            "for (int i = 0; i < ${1:length}; i++) {",
            "    sb.append(chars.charAt(random.nextInt(chars.length())));",
            "}",
            "String ${2:result} = sb.toString();"
        ],
        "description": "Java 生成随机字符串（需要 java.util.Random）"
    },
    "ja_cwd": {
        "prefix": "ja_cwd",
        "body": [
            "String ${1:cwd} = System.getProperty(\"user.dir\");"
        ],
        "description": "Java 获取当前工作目录"
    },
    "ja_args": {
        "prefix": "ja_args",
        "body": [
            "for (int i = 0; i < args.length; i++) {",
            "    String ${1:arg} = args[i];",
            "    $0",
            "}"
        ],
        "description": "Java 遍历命令行参数"
    },
    "ja_input": {
        "prefix": "ja_input",
        "body": [
            "Scanner ${1:scanner} = new Scanner(System.in);",
            "String ${2:input} = ${1:scanner}.nextLine();"
        ],
        "description": "Java 读取用户输入一行（需要 java.util.Scanner）"
    },
    "ja_thread_lock": {
        "prefix": "ja_thread_lock",
        "body": [
            "ReentrantLock ${1:lock} = new ReentrantLock();",
            "${1:lock}.lock();",
            "try {",
            "    $2",
            "} finally {",
            "    ${1:lock}.unlock();",
            "}"
        ],
        "description": "Java 互斥锁 ReentrantLock（需要 java.util.concurrent.locks.*）"
    },
    "ja_thread_rlock": {
        "prefix": "ja_thread_rlock",
        "body": [
            "ReentrantReadWriteLock ${1:rwlock} = new ReentrantReadWriteLock();",
            "${1:rwlock}.readLock().lock();",
            "try {",
            "    $2",
            "} finally {",
            "    ${1:rwlock}.readLock().unlock();",
            "}"
        ],
        "description": "Java 读写锁 ReentrantReadWriteLock（需要 java.util.concurrent.locks.*）"
    },
    "ja_thread_semaphore": {
        "prefix": "ja_thread_semaphore",
        "body": [
            "Semaphore ${1:semaphore} = new Semaphore(${2:permits});",
            "${1:semaphore}.acquire();",
            "try {",
            "    $3",
            "} finally {",
            "    ${1:semaphore}.release();",
            "}"
        ],
        "description": "Java 信号量 Semaphore（需要 java.util.concurrent.Semaphore）"
    },
    "ja_thread_condition": {
        "prefix": "ja_thread_condition",
        "body": [
            "ReentrantLock ${1:lock} = new ReentrantLock();",
            "Condition ${2:condition} = ${1:lock}.newCondition();",
            "${1:lock}.lock();",
            "try {",
            "    while (!${3:predicate}) {",
            "        ${2:condition}.await();",
            "    }",
            "    $4",
            "} finally {",
            "    ${1:lock}.unlock();",
            "}"
        ],
        "description": "Java 条件变量 Condition（需要 java.util.concurrent.locks.*）"
    },
    "ja_thread_event": {
        "prefix": "ja_thread_event",
        "body": [
            "CountDownLatch ${1:event} = new CountDownLatch(1);",
            "// 等待端: ${1:event}.await();",
            "// 触发端: ${1:event}.countDown();"
        ],
        "description": "Java 事件 CountDownLatch（需要 java.util.concurrent.CountDownLatch）"
    },
    "ja_thread_barrier": {
        "prefix": "ja_thread_barrier",
        "body": [
            "CyclicBarrier ${1:barrier} = new CyclicBarrier(${2:parties}, () -> {",
            "    ${3:// barrier action}",
            "});",
            "${1:barrier}.await();"
        ],
        "description": "Java 屏障 CyclicBarrier（需要 java.util.concurrent.CyclicBarrier）"
    },
    "ja_process": {
        "prefix": "ja_process",
        "body": [
            "List<Process> ${1:processes} = new ArrayList<>();",
            "for (String ${2:cmd} : ${3:commands}) {",
            "    ${1:processes}.add(new ProcessBuilder(${2:cmd}.split(\" \")).start());",
            "}",
            "for (Process ${4:p} : ${1:processes}) {",
            "    ${4:p}.waitFor();",
            "}"
        ],
        "description": "Java 多进程并行执行并等待全部完成（需要 java.util.*）"
    },
    "ja_log": {
        "prefix": "ja_log",
        "body": [
            "private static final Logger logger = Logger.getLogger(${1:ClassName}.class.getName());",
            "logger.${2|info,warning,severe|}(\"${3:message}\");"
        ],
        "description": "Java 日志输出（需要 java.util.logging.*）"
    },
    "ja_signal": {
        "prefix": "ja_signal",
        "body": [
            "Signal.handle(new Signal(\"${1:SIGTERM}\"), sig -> {",
            "    System.out.println(\"收到信号: \" + sig.getName());",
            "    ${2:// cleanup}",
            "    System.exit(0);",
            "});"
        ],
        "description": "Java 信号监听（需要 import sun.misc.Signal，注意 sun.* 是内部 API）"
    }
}
