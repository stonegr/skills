    "字符串长度验证": {
        "prefix": "ms_valid_length",
        "body": [
            "from marshmallow import Schema, fields, validate",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:name} = fields.Str(validate=validate.Length(min=${3:1}, max=${4:80}))"
        ],
        "description": "字符串长度验证"
    },
    "数值范围验证": {
        "prefix": "ms_valid_range",
        "body": [
            "from marshmallow import Schema, fields, validate",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:age} = fields.Int(validate=validate.Range(min=${3:0}, max=${4:150}))"
        ],
        "description": "数值范围验证"
    },
    "正则验证": {
        "prefix": "ms_valid_regexp",
        "body": [
            "from marshmallow import Schema, fields, validate",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:code} = fields.Str(validate=validate.Regexp(${3:r'^A-Z{2,}$'}))"
        ],
        "description": "正则验证"
    },
    "枚举值验证": {
        "prefix": "ms_valid_oneof",
        "body": [
            "from marshmallow import Schema, fields, validate",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:status} = fields.Str(validate=validate.OneOf([${3:'draft'}, ${4:'published'}]))"
        ],
        "description": "枚举值验证"
    },
    "邮箱格式验证": {
        "prefix": "ms_valid_email",
        "body": [
            "from marshmallow import Schema, fields, validate",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:email} = fields.Str(validate=validate.Email())"
        ],
        "description": "邮箱格式验证"
    },
    "自定义验证函数": {
        "prefix": "ms_valid_custom",
        "body": [
            "from marshmallow import Schema, fields, ValidationError",
            "",
            "def ${1:validate_func}(${2:value}):",
            "    if not ${3:condition}:",
            "        raise ValidationError(${4:'Invalid value'})",
            "",
            "class ${5:MySchema}(Schema):",
            "    ${6:field} = fields.Str(validate=${1:validate_func})"
        ],
        "description": "自定义验证函数"
    },
    "嵌套另一个 Schema": {
        "prefix": "ms_nested",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:ChildSchema}(Schema):",
            "    ${2:name} = fields.${3:Str}()",
            "",
            "class ${4:ParentSchema}(Schema):",
            "    ${5:child} = fields.Nested(${1:ChildSchema})"
        ],
        "description": "嵌套另一个 Schema"
    },
    "嵌套列表": {
        "prefix": "ms_nested_many",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:ChildSchema}(Schema):",
            "    ${2:name} = fields.${3:Str}()",
            "",
            "class ${4:ParentSchema}(Schema):",
            "    ${5:children} = fields.Nested(${1:ChildSchema}, many=True)"
        ],
        "description": "嵌套列表"
    },
    "自嵌套": {
        "prefix": "ms_nested_self",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:NodeSchema}(Schema):",
            "    ${2:value} = fields.${3:Str}()",
            "    ${4:children} = fields.List(fields.Nested('self'))"
        ],
        "description": "自嵌套（树形结构）"
    },
    "从其他 attribute 加载嵌套": {
        "prefix": "ms_nested_load_from",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:ProfileSchema}(Schema):",
            "    ${2:bio} = fields.${3:Str}()",
            "",
            "class ${4:UserSchema}(Schema):",
            "    ${5:profile} = fields.Nested(${1:ProfileSchema}, attribute=${6:'profile_obj'})"
        ],
        "description": "从其他 attribute 加载嵌套"
    },
    "加载前预处理数据": {
        "prefix": "ms_pre_load",
        "body": [
            "from marshmallow import Schema, fields, pre_load",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:field} = fields.${3:Str}()",
            "",
            "    @pre_load",
            "    def ${4:preprocess}(self, data, **kwargs):",
            "        ${5:# 加载前预处理原始数据}",
            "        return data"
        ],
        "description": "加载前预处理数据"
    },
    "加载后构造领域对象": {
        "prefix": "ms_post_load",
        "body": [
            "from marshmallow import Schema, fields, post_load",
            "",
            "class ${1:UserSchema}(Schema):",
            "    ${2:name} = fields.${3:Str}()",
            "    ${4:age} = fields.${5:Int}()",
            "",
            "    @post_load",
            "    def ${6:make_user}(self, data, **kwargs):",
            "        return ${7:User}(**data)"
        ],
        "description": "加载后构造领域对象"
    },
    "序列化前预处理对象": {
        "prefix": "ms_pre_dump",
        "body": [
            "from marshmallow import Schema, fields, pre_dump",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:field} = fields.${3:Str}()",
            "",
            "    @pre_dump",
            "    def ${4:preprocess}(self, data, **kwargs):",
            "        ${5:# 序列化前预处理对象}",
            "        return data"
        ],
        "description": "序列化前预处理对象"
    },
    "序列化后处理输出": {
        "prefix": "ms_post_dump",
        "body": [
            "from marshmallow import Schema, fields, post_dump",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:field} = fields.${3:Str}()",
            "",
            "    @post_dump",
            "    def ${4:add_extra}(self, data, **kwargs):",
            "        data[${5:'extra'}] = ${6:'value'}",
            "        return data"
        ],
        "description": "序列化后处理输出"
    },
    "Method 字段": {
        "prefix": "ms_field_method",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:full_name} = fields.Method('${3:get_full_name}')",
            "",
            "    def ${3:get_full_name}(self, obj):",
            "        return f'{obj.${4:first_name}} {obj.${5:last_name}}'"
        ],
        "description": "Method 字段（可访问 self）"
    },
    "Function 字段": {
        "prefix": "ms_field_function",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "def ${1:get_value}(obj):",
            "    return obj.${2:attr}",
            "",
            "class ${3:MySchema}(Schema):",
            "    ${4:field} = fields.Function(${1:get_value})"
        ],
        "description": "Function 字段（纯函数）"
    },
    "常量字段": {
        "prefix": "ms_field_constant",
        "body": [
            "from marshmallow import Schema, fields",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:type} = fields.Constant(${3:'default_value'})"
        ],
        "description": "常量字段（固定值）"
    },
    "字段级校验装饰器": {
        "prefix": "ms_validates",
        "body": [
            "from marshmallow import Schema, fields, validates, ValidationError",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:field} = fields.${3:Str}()",
            "",
            "    @validates('${2:field}')",
            "    def ${4:check_field}(self, value, **kwargs):",
            "        if not ${5:condition}:",
            "            raise ValidationError(${6:'Invalid value'})"
        ],
        "description": "字段级校验装饰器"
    },
    "整 Schema 校验装饰器": {
        "prefix": "ms_validates_schema",
        "body": [
            "from marshmallow import Schema, fields, validates_schema, ValidationError",
            "",
            "class ${1:MySchema}(Schema):",
            "    ${2:start} = fields.${3:Date}()",
            "    ${4:end} = fields.${5:Date}()",
            "",
            "    @validates_schema",
            "    def ${6:check_dates}(self, data, **kwargs):",
            "        if data['${2:start}'] > data['${4:end}']:",
            "            raise ValidationError(${7:'start must be before end'})"
        ],
        "description": "整 Schema 校验装饰器"
    },
    "部分加载": {
        "prefix": "ms_partial",
        "body": [
            "from marshmallow import Schema, fields",
