            "class ${1:UserSchema}(Schema):",
            "    ${2:name} = fields.${3:Str}(required=True)",
            "    ${4:age} = fields.${5:Int}()",
            "",
            "${6:result} = ${1:UserSchema}(partial=True).load(${7:data})"
        ],
        "description": "部分加载（PATCH 更新）"
    },
