        "prefix": "ja_thread_lock",
        "body": [
            "ReentrantLock ${1:lock} = new ReentrantLock();",
            "${1:lock}.lock();",
            "try {",
            "    $2",
            "} finally {",
            "    ${1:lock}.unlock();",
            "}"
        ],
        "description": "互斥锁 ReentrantLock（需要 java.util.concurrent.locks.*）"
    },
    "读写锁 ReentrantReadWriteLock": {
        "prefix": "ja_thread_rlock",
        "body": [
            "ReentrantReadWriteLock ${1:rwlock} = new ReentrantReadWriteLock();",
            "${1:rwlock}.readLock().lock();",
            "try {",
            "    $2",
            "} finally {",
            "    ${1:rwlock}.readLock().unlock();",
            "}"
        ],
        "description": "读写锁 ReentrantReadWriteLock（需要 java.util.concurrent.locks.*）"
