            "async def ${2:read_items}(${3:x_token: str = Header(...)}):",
            "    return ${4:{'token': x_token}}"
        ],
        "description": "Header 参数"
    },
    "Form 表单参数": {
        "prefix": "fa_form_param",
        "body": [
            "from fastapi import FastAPI, Form",
            "app = FastAPI()",
            "",
            "@app.post(${1:'/login'})",
            "async def ${2:login}(${3:username: str = Form(...)}):",
            "    return ${4:{'username': username}}"
        ],
        "description": "Form 表单参数"
