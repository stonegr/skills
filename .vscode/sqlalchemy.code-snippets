  "sa_transaction": {
    "prefix": "sa_transaction",
    "body": [
      "${1:session} = ${2:SessionLocal}()",
      "${1:session}.begin()",
      "try:",
      "    ${1:session}.add(${3:obj})",
      "    ${1:session}.commit()",
      "except Exception:",
      "    ${1:session}.rollback()",
      "    raise",
      "finally:",
      "    ${1:session}.close()"
    ],
    "description": "事务块 try/except/finally"
  },
  "sa_rollback": {
    "prefix": "sa_rollback",
    "body": [
      "try:",
      "    ${1:session}.add(${2:obj})",
      "    ${1:session}.commit()",
      "except Exception as ${3:e}:",
      "    ${1:session}.rollback()",
      "    ${4:raise}"
    ],
    "description": "异常回滚处理"
  },
